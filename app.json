{
  "expo": {
    "name": "MyKontroller",
    "slug": "mykontroller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mykontroller",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F33"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mykontroller.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F33"
      },
      "package": "com.mykontroller.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "owner": "mirzarahimdev",
    "extra": {
      "eas": {
        "projectId": "b0b88280-537f-4e43-aa09-4d811c0d59a3"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
